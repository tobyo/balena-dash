FROM balenalib/%%BALENA_MACHINE_NAME%%-alpine:latest

# tzdata: cron fires on local time, so the zoneinfo database has to be
# present for the TZ env var to mean anything.
# libcec-tools: provides cec-client for the HDMI TV on/off schedule.
RUN install_packages tzdata libcec-tools

COPY scripts /usr/src/app
RUN chmod +x /usr/src/app/*.sh

CMD ["/usr/src/app/start.sh"]
